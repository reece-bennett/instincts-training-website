{{#> page title="Page not found"}}
  <section class="bg-stone-100 text-neutral-600 flex items-center justify-center px-6 py-16">
    <div class="text-center max-w-lg">
      <p class="text-7xl md:text-8xl font-extrabold tracking-tight mb-2">404</p>
      <h1 class="text-2xl md:text-3xl font-semibold mb-4">Page Not Found</h1>
      <p class="lg:text-lg mb-8">The page or link you are trying to access doesn't exist or has been moved.</p>
      {{#> link-button style="dark" href="/"}}Go to homepage{{/link-button}}
    </div>
  </section>
{{/page}}
